@page
@model ExternalLoginModel
@{
    ViewData["Title"] = "Poveži vanjski račun";
}

<section class="form-page form-page--create">
    <div class="form-header">
        <h1>Poveži vanjski račun</h1>
        <p class="section-copy">
            Uspješno ste se autenticirali putem @Model.ProviderDisplayName. Molimo dovršite registraciju unosom dodatnih podataka.
        </p>
    </div>

    <article class="content-card form-card">
        <form id="confirmation-form" method="post" asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" class="ajax-form" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="form-group">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control form-input" autocomplete="username" placeholder="ime@primjer.com" />
                <span asp-validation-for="Input.Email" class="form-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.OIB" class="form-label"></label>
                <input asp-for="Input.OIB" class="form-control form-input" placeholder="Unesite OIB (11 znamenki)" />
                <span asp-validation-for="Input.OIB" class="form-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.JMBG" class="form-label"></label>
                <input asp-for="Input.JMBG" class="form-control form-input" placeholder="Unesite JMBG (13 znamenki)" />
                <span asp-validation-for="Input.JMBG" class="form-error"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Registriraj se</button>
            </div>
        </form>
    </article>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("~/Views/Shared/_ValidationScriptsPartial.cshtml");
    }
    <script src="~/js/form-validation.js"></script>
}
