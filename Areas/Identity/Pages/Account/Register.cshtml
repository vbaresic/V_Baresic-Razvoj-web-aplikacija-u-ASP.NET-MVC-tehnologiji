@page
@model RegisterModel
@{
    ViewData["Title"] = "Registracija";
}

<section class="form-page form-page--create">
    <div class="form-header">
        <h1>Registracija</h1>
        <p class="section-copy">Otvori novi račun kako bi mogao prijavljivati timove i sudjelovati na turnirima.</p>
    </div>

    <article class="content-card form-card">
        <form id="registerForm" method="post" asp-route-returnUrl="@Model.ReturnUrl" class="ajax-form" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="form-group">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control form-input" autocomplete="username" placeholder="ime@primjer.com" />
                <span asp-validation-for="Input.Email" class="form-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.OIB" class="form-label"></label>
                <input asp-for="Input.OIB" class="form-control form-input" placeholder="Unesite OIB (11 znamenki)" />
                <span asp-validation-for="Input.OIB" class="form-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.JMBG" class="form-label"></label>
                <input asp-for="Input.JMBG" class="form-control form-input" placeholder="Unesite JMBG (13 znamenki)" />
                <span asp-validation-for="Input.JMBG" class="form-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control form-input" autocomplete="new-password" placeholder="Unesite lozinku" />
                <span asp-validation-for="Input.Password" class="form-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                <input asp-for="Input.ConfirmPassword" class="form-control form-input" autocomplete="new-password" placeholder="Potvrdite lozinku" />
                <span asp-validation-for="Input.ConfirmPassword" class="form-error"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Registriraj se</button>
            </div>
        </form>

        @if (Model.ExternalLogins.Any())
        {
            <div class="form-divider" role="separator" aria-label="ili">
                <span>ili</span>
            </div>

            <section class="external-logins" aria-label="Vanjske prijave">
                <h2 class="external-logins-title">Ili se registriraj pomoću:</h2>
                @foreach (var provider in Model.ExternalLogins)
                {
                    <form asp-area="Identity" asp-page="./ExternalLogin" asp-page-handler="OnPost" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="external-login-form">
                        <button type="submit" class="btn btn-secondary external-login-btn" name="provider" value="@provider.Name" title="Registracija putem @provider.DisplayName-a">
                            Registracija putem @provider.DisplayName-a
                        </button>
                    </form>
                }
            </section>
        }

        <p class="form-footnote">
            Već imaš račun? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Prijavi se</a>
        </p>
    </article>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("~/Views/Shared/_ValidationScriptsPartial.cshtml");
    }
    <script src="~/js/form-validation.js"></script>
}
