@model Sponsor
@{
    ViewData["Title"] = $"Delete {Model.Name}";
}

<section class="form-page form-page--delete">
    <div class="form-header">
        <h1>Delete Sponsor</h1>
        <p class="section-copy warning">This action cannot be undone. Please confirm before deleting.</p>
    </div>

    <article class="content-card form-card form-card--danger">
        <div class="delete-confirmation">
            <h2>Are you sure?</h2>
            <p>You are about to delete the following sponsor:</p>
            
            <div class="delete-info">
                <p><strong>Name:</strong> @Model.Name</p>
                <p><strong>Website:</strong> <a href="@Model.Website" target="_blank">@Model.Website</a></p>
                <p><strong>Email:</strong> @Model.ContactEmail</p>
                <p><strong>Phone:</strong> @Model.ContactPhone</p>
                <p><strong>Sponsorship Amount:</strong> $@Model.SponsorshipAmount:F2</p>
                <p><strong>Contract Period:</strong> @Model.ContractStart:dd MMM yyyy - @Model.ContractEnd:dd MMM yyyy</p>
            </div>

            <form asp-action="Delete" method="post" class="delete-form">
                <div class="form-actions">
                    <button type="submit" class="btn btn-danger">Confirm Delete</button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </article>
</section>
