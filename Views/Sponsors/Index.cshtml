@model IEnumerable<EntityCardViewModel>
@{
    ViewData["Title"] = "Sponsors";
}

<section class="content-section directory-page-section">
    <div class="section-heading section-heading--anchored">
        <div>
            <p class="eyebrow">Directory</p>
            <h1>@ViewData["Title"]</h1>
            <p class="section-copy">@ViewData["EntityCount"] sponsors found. Explore partner value and where each contract is currently active.</p>
        </div>
        <div class="section-heading__actions">
            <a class="section-cta" asp-controller="Tournaments" asp-action="Index">View events</a>
        </div>
    </div>

    <div class="card-grid card-grid--spotlight card-grid--sponsors">
        @foreach (var card in Model)
        {
            <article class="spotlight-card people-card people-card--sponsor">
                <a class="people-card__hit-area" href="@card.LinkUrl" aria-label="Open @card.Title details"></a>
                <div class="spotlight-card__glow"></div>
                <div class="spotlight-card__ribbon">Partner</div>
                <div class="spotlight-card__header">
                    <div class="spotlight-card__badge spotlight-card__badge--blue">
                        <span class="spotlight-card__badge-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M12 2 3 7v10l9 5 9-5V7zm0 18-7-3.9V8.5L12 12l7-3.5v8.6z" fill="currentColor"/></svg>
                        </span>
                        <span>Sponsor</span>
                    </div>
                    <div class="spotlight-card__metric">
                        <span>Partner</span>
                        <small>Profile</small>
                    </div>
                </div>
                <div class="spotlight-card__body">
                    <h3>@card.Title</h3>
                    <p>@card.Subtitle</p>
                    <div class="people-card__title-spacer" aria-hidden="true"></div>
                </div>
                <div class="people-card__role-band" aria-label="Phone contact information">
                    <span class="people-card__role-label">Phone</span>
                    <strong>@card.Body</strong>
                </div>
            </article>
        }
    </div>
</section>