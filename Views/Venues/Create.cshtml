@model Venue
@{
    ViewData["Title"] = "Create Venue";
}

<section class="form-page form-page--create">
    <div class="form-header">
        <h1>Create New Venue</h1>
        <p class="section-copy">Add a new tournament venue to the system.</p>
    </div>

    <article class="content-card form-card">
        <form asp-action="Create" method="post" class="ajax-form" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="form-group">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control form-input" placeholder="Enter venue name" required />
                <span asp-validation-for="Name" class="form-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Address" class="form-label"></label>
                <input asp-for="Address" class="form-control form-input" placeholder="Enter street address" required />
                <span asp-validation-for="Address" class="form-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="City" class="form-label"></label>
                <input asp-for="City" class="form-control form-input" placeholder="Enter city" required />
                <span asp-validation-for="City" class="form-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Capacity" class="form-label"></label>
                <input asp-for="Capacity" type="number" class="form-control form-input" placeholder="Venue capacity" min="1" required />
                <span asp-validation-for="Capacity" class="form-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="IsAvailable" class="form-label"></label>
                <select asp-for="IsAvailable" class="form-control form-input">
                    <option value="true">Available</option>
                    <option value="false">Not Available</option>
                </select>
                <span asp-validation-for="IsAvailable" class="form-error"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Create Venue</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </article>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/form-validation.js"></script>
}
