@model Player
@{
    ViewData["Title"] = $"Delete {Model.GamerTag}";
}

<section class="form-page form-page--delete">
    <div class="form-header">
        <h1>Delete Player</h1>
        <p class="section-copy warning">This action cannot be undone. Please confirm before deleting.</p>
    </div>

    <article class="content-card form-card form-card--danger">
        <div class="delete-confirmation">
            <h2>Are you sure?</h2>
            <p>You are about to delete the following player:</p>
            
            <div class="delete-info">
                <p><strong>Gamer Tag:</strong> @Model.GamerTag</p>
                <p><strong>Name:</strong> @Model.Name</p>
                <p><strong>Role:</strong> @Model.Role</p>
                <p><strong>Primary Position:</strong> @Model.PreferredPosition</p>
                <p><strong>Secondary Position:</strong> @Model.SecondaryPosition</p>
                <p><strong>League Tier:</strong> @Model.AccountInformation?.LeagueTier</p>
                <p><strong>Joined:</strong> @Model.JoinedAt.ToString("dd MMM yyyy")</p>
            </div>

            <form asp-action="Delete" method="post" class="delete-form">
                <div class="form-actions">
                    <button type="submit" class="btn btn-danger">Confirm Delete</button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </article>
</section>
