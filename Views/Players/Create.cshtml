@model Player
@{
    ViewData["Title"] = "Create Player";
}

<section class="form-page form-page--create">
    <div class="form-header">
        <h1>Create New Player</h1>
        <p class="section-copy">Add a new player to the tournament system.</p>
    </div>

    <article class="content-card form-card">
        <form asp-action="Create" method="post" class="ajax-form" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control form-input" placeholder="Enter player name" />
                <span asp-validation-for="Name" class="form-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="GamerTag" class="form-label"></label>
                <input asp-for="GamerTag" class="form-control form-input" placeholder="Enter gamer tag" />
                <span asp-validation-for="GamerTag" class="form-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Role" class="form-label"></label>
                @Html.DropDownListFor(m => m.Role, Html.GetEnumSelectList<PlayerRole>(), "Select Role", new { @class = "form-control" })
                <span asp-validation-for="Role" class="form-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="PreferredPosition" class="form-label"></label>
                @Html.DropDownListFor(m => m.PreferredPosition, Html.GetEnumSelectList<Position>(), "Select Position", new { @class = "form-control" })
                <span asp-validation-for="PreferredPosition" class="form-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="SecondaryPosition" class="form-label"></label>
                @Html.DropDownListFor(m => m.SecondaryPosition, Html.GetEnumSelectList<Position>(), "Select Position", new { @class = "form-control" })
                <span asp-validation-for="SecondaryPosition" class="form-error"></span>
            </div>

            @await Html.PartialAsync("_DateTimePicker", (DateTime?)Model.JoinedAt, new ViewDataDictionary(ViewData) {
                { "FieldName", "JoinedAt" },
                { "Label", Html.DisplayNameFor(m => m.JoinedAt) },
                { "Required", false }
            })

            <div class="form-group">
                <label asp-for="AccountInformation.SummonerName" class="form-label"></label>
                <input asp-for="AccountInformation.SummonerName" class="form-control form-input" />
                <span asp-validation-for="AccountInformation.SummonerName" class="form-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="AccountInformation.RiotTag" class="form-label"></label>
                <input asp-for="AccountInformation.RiotTag" class="form-control form-input" />
                <span asp-validation-for="AccountInformation.RiotTag" class="form-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="AccountInformation.Region" class="form-label"></label>
                @Html.DropDownListFor(m => m.AccountInformation.Region, Html.GetEnumSelectList<Region>(), "Select Region", new { @class = "form-control" })
                <span asp-validation-for="AccountInformation.Region" class="form-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="AccountInformation.LeagueTier" class="form-label"></label>
                @Html.DropDownListFor(m => m.AccountInformation.LeagueTier, Html.GetEnumSelectList<LeagueTier>(), "Select Tier", new { @class = "form-control" })
                <span asp-validation-for="AccountInformation.LeagueTier" class="form-error"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Create Player</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </article>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/form-validation.js"></script>
    <script src="~/js/date-time-picker.js"></script>
}
