@using Microsoft.AspNetCore.Identity
@using League_of_Legends_Tournament_Hosting.Models
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <div class="topbar-user" aria-label="Korisnički račun">
        <span class="topbar-user-name">@User.Identity?.Name</span>
        @if (User.IsInRole("Admin"))
        {
            @await Html.PartialAsync("Components/_Badge", new BadgeViewModel("Admin", "red"))
        }
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")" method="post" class="topbar-logout-form">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-link topbar-btn topbar-btn--text" aria-label="Odjava">Odjava</button>
        </form>
    </div>
}
else
{
    <a asp-area="Identity" asp-page="/Account/Login" class="topbar-btn topbar-btn--text" aria-label="Prijava">Prijava</a>
    <a asp-area="Identity" asp-page="/Account/Register" class="topbar-btn topbar-btn--text" aria-label="Registracija">Registracija</a>
}
