@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="content-section directory-page-section">
    <div class="section-heading section-heading--anchored">
        <div>
            <p class="eyebrow">System alert</p>
            <h1>@ViewData["Title"]</h1>
            <p class="section-copy">An unexpected issue occurred while processing this request.</p>
        </div>
        <div class="section-heading__actions">
            <a class="section-cta" asp-controller="Home" asp-action="Index">Return home</a>
        </div>
    </div>

    <article class="content-card detail-main">
        <h2>What happened</h2>
        <p>Try again in a moment. If this persists, review logs and run locally with Development environment enabled.</p>

        @if (Model.ShowRequestId)
        {
            <p>
                <strong>Request ID:</strong>
                <span class="badge-pill badge-pill--red">@Model.RequestId</span>
            </p>
        }

        <h2>Development mode guidance</h2>
        <p>
            Swapping to <strong>Development</strong> environment will display more detailed information about the error that occurred.
        </p>
        <p>
            <strong>The Development environment should not be enabled for deployed applications.</strong>
            It can expose sensitive exception details to end users.
        </p>
    </article>
</section>
