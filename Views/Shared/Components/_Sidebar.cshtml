<aside class="app-sidebar">
    <div class="site-branding">
        <span class="site-brand-short">LA</span>
        <span class="site-brand-full">League Atlas</span>
    </div>

    <div class="sidebar-shell-actions">
        <button class="sidebar-shell-btn sidebar-shell-btn--hide" type="button" data-sidebar-action="hide" aria-label="Hide sidebar" title="Hide sidebar">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h11.2l-4.6-4.6L12 6l6 6-6 6-1.4-1.4 4.6-4.6H4z" fill="currentColor"/></svg>
        </button>
        <button class="sidebar-shell-btn sidebar-shell-btn--collapse" type="button" data-sidebar-action="collapse" aria-label="Collapse sidebar" title="Collapse sidebar">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h8v2H4zm0 5h12v2H4zm0 5h8v2H4zM16 7l4 5-4 5z" fill="currentColor"/></svg>
        </button>
        <button class="sidebar-shell-btn sidebar-shell-btn--expand" type="button" data-sidebar-action="expand" aria-label="Expand sidebar" title="Expand sidebar">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6h-8v2h8zm0 5H8v2h12zm0 5h-8v2h8zM8 7l-4 5 4 5z" fill="currentColor"/></svg>
        </button>
    </div>

    <nav class="sidebar-nav" aria-label="Primary navigation">
        <a class="sidebar-nav__item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "is-active" : "")" asp-controller="Home" asp-action="Index" title="Dashboard">
            <span class="sidebar-nav__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M4 11.5 12 4l8 7.5V20a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1z" fill="currentColor"/></svg>
            </span>
            <span class="sidebar-nav__label">Dashboard</span>
        </a>

        <a class="sidebar-nav__item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Tournaments" ? "is-active" : "")" asp-controller="Tournaments" asp-action="Index" title="Tournaments">
            <span class="sidebar-nav__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M7 3h10v4c0 2.8-2.2 5-5 5S7 9.8 7 7zm3 11h4v2h-4zm-7 0h4v2H3zm14 0h4v2h-4z" fill="currentColor"/></svg>
            </span>
            <span class="sidebar-nav__label">Tournaments</span>
        </a>

        <a class="sidebar-nav__item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Teams" ? "is-active" : "")" asp-controller="Teams" asp-action="Index" title="Teams">
            <span class="sidebar-nav__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M5 20a7 7 0 0 1 14 0zm7-8a4 4 0 1 0 0-8 4 4 0 0 0 0 8z" fill="currentColor"/></svg>
            </span>
            <span class="sidebar-nav__label">Teams</span>
        </a>

        <a class="sidebar-nav__item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Players" ? "is-active" : "")" asp-controller="Players" asp-action="Index" title="Players">
            <span class="sidebar-nav__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4zm0 2c-4.4 0-8 2.2-8 5v2h16v-2c0-2.8-3.6-5-8-5z" fill="currentColor"/></svg>
            </span>
            <span class="sidebar-nav__label">Players</span>
        </a>

        <div class="sidebar-dropdown" data-dropdown="looking-for">
            <button class="sidebar-dropdown-toggle" type="button" title="Looking For">
                <span class="sidebar-nav__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M11 2a9 9 0 1 0 5.66 16l4.17 4.17 1.42-1.42-4.17-4.17A9 9 0 0 0 11 2zm0 2a7 7 0 1 1 0 14 7 7 0 0 1 0-14zm-1 3h2v4h-2zm0 5h2v2h-2z" fill="currentColor"/></svg>
                </span>
                <span class="sidebar-nav__label">Looking for</span>
                <svg class="sidebar-dropdown-arrow" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" fill="none"/></svg>
            </button>

            <div class="sidebar-dropdown-menu">
                <a class="sidebar-dropdown-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Coaches" ? "is-active" : "")" asp-controller="Coaches" asp-action="Index">
                    <span class="sidebar-dropdown-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M12 3a5 5 0 1 1-5 5 5 5 0 0 1 5-5zm-7 16a7 7 0 0 1 14 0z" fill="currentColor"/></svg>
                    </span>
                    <span>Coaches</span>
                </a>
                <a class="sidebar-dropdown-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Managers" ? "is-active" : "")" asp-controller="Managers" asp-action="Index">
                    <span class="sidebar-dropdown-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M12 2 3 6v5c0 5.5 3.8 9.8 9 11 5.2-1.2 9-5.5 9-11V6zm0 7.5L6.5 6.7 12 4l5.5 2.7z" fill="currentColor"/></svg>
                    </span>
                    <span>Managers</span>
                </a>
                <a class="sidebar-dropdown-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Sponsors" ? "is-active" : "")" asp-controller="Sponsors" asp-action="Index">
                    <span class="sidebar-dropdown-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M12 2 3 7v10l9 5 9-5V7zm0 18-7-3.9V8.5L12 12l7-3.5v8.6z" fill="currentColor"/></svg>
                    </span>
                    <span>Sponsors</span>
                </a>
                <a class="sidebar-dropdown-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Venues" ? "is-active" : "")" asp-controller="Venues" asp-action="Index">
                    <span class="sidebar-dropdown-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M12 2 4 6v16h16V6zm-1 14H8v-2h3zm0-4H8v-2h3zm5 4h-3v-2h3zm0-4h-3v-2h3z" fill="currentColor"/></svg>
                    </span>
                    <span>Venues</span>
                </a>
            </div>
        </div>
    </nav>

    <div class="sidebar-spotlight">
        <span>System</span>
        <strong>League Atlas</strong>
        <p>Tournament console</p>
    </div>
</aside>
