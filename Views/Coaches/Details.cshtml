@model Coach
@{
    ViewData["Title"] = Model.Name;
    var coachTeam = ViewData["CoachTeam"] as Team;
}

<section class="detail-page detail-page--coach">
    <article class="content-card detail-hero detail-hero--purple">
        <div class="detail-hero__accent"></div>
        <p class="eyebrow">Coach profile</p>
        <h1>@Model.Name</h1>
        <p class="detail-hero__subtitle">@Model.GamerTag</p>
        <div class="meta-pills detail-hero__pills">
            <span class="badge-pill badge-pill--blue">@Model.YearsOfExperience years experience</span>
            <span class="badge-pill badge-pill--purple">Leadership</span>
        </div>
        <div class="detail-stat-strip">
            <div class="detail-stat">
                <span>Years</span>
                <strong>@Model.YearsOfExperience</strong>
            </div>
            <div class="detail-stat">
                <span>Hired</span>
                <strong>@Model.HiredAt.ToString("dd MMM yyyy")</strong>
            </div>
            <div class="detail-stat">
                <span>Status</span>
                <strong>@(coachTeam is null ? "Open" : "Assigned")</strong>
            </div>
        </div>
    </article>

    <div class="detail-layout detail-layout--rich">
        <article class="content-card detail-panel detail-panel--primary">
            <h2>Experience</h2>
            <div class="detail-grid">
                <div>
                    <p><strong>Years:</strong> @Model.YearsOfExperience</p>
                    <p><strong>Hired:</strong> @Model.HiredAt.ToString("dd MMM yyyy")</p>
                </div>
                <div>
                    <h2>Assigned team</h2>
                    @if (coachTeam is null)
                    {
                        <p>No team assignment found.</p>
                    }
                    else
                    {
                        <a class="badge-pill badge-pill--gold" asp-controller="Teams" asp-action="Details" asp-route-id="@coachTeam.Id">@coachTeam.Name</a>
                    }
                </div>
            </div>
        </article>

        <aside class="detail-side">
            <section class="content-card detail-panel">
                <h2>Quick actions</h2>
                <div class="badge-stack">
                    <a class="badge-pill badge-pill--blue" asp-controller="Teams" asp-action="Index">All teams</a>
                    <a class="badge-pill badge-pill--purple" asp-controller="Coaches" asp-action="Index">All coaches</a>
                </div>
            </section>

            <section class="content-card detail-panel">
                <h2>Assignment status</h2>
                @if (coachTeam is null)
                {
                    <p>Coach is currently unassigned and available for placement.</p>
                }
                else
                {
                    <p>Currently leading <strong>@coachTeam.Name</strong> and active in roster development.</p>
                }
            </section>
        </aside>
    </div>
</section>