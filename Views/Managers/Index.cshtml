@model IEnumerable<EntityCardViewModel>
@{
    ViewData["Title"] = "Managers";
}

<section class="content-section directory-page-section">
    <div class="section-heading section-heading--anchored">
        <div>
            <p class="eyebrow">Directory</p>
            <h1>@ViewData["Title"]</h1>
            <p class="section-copy">@ViewData["EntityCount"] managers found. Track operations leadership and move to connected teams quickly.</p>
        </div>
        <div class="section-heading__actions">
            <a class="section-cta" asp-controller="Teams" asp-action="Index">Browse teams</a>
        </div>
    </div>

    <div class="search-bar-container">
        <input type="text" id="searchInput" class="search-input" placeholder="Search managers..." aria-label="Search managers" />
        <button id="searchBtn" class="search-btn" aria-label="Search">
            <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="currentColor"/></svg>
        </button>
        <button id="clearSearchBtn" class="clear-search-btn" aria-label="Clear search" style="display: none;">
            <svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41z" fill="currentColor"/></svg>
        </button>
    </div>
    
    <div id="searchMessage" class="search-message" style="display: none;"></div>

    <div id="resultGrid" class="card-grid card-grid--spotlight card-grid--people card-grid--managers">
        @foreach (var entry in Model.Select((card, index) => new { card, index }))
        {
            var badgeVariant = entry.index % 3 == 0 ? "purple" : entry.index % 3 == 1 ? "green" : "orange";

            <article class="spotlight-card people-card people-card--manager spotlight-card--@badgeVariant">
                <a class="people-card__hit-area" href="@entry.card.LinkUrl" aria-label="Open @entry.card.Title details"></a>
                <div class="spotlight-card__glow"></div>
                <div class="spotlight-card__ribbon">Manager profile</div>
                <div class="spotlight-card__header">
                    <div class="spotlight-card__badge spotlight-card__badge--@badgeVariant">
                        <span class="spotlight-card__badge-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M12 2 3 6v5c0 5.5 3.8 9.8 9 11 5.2-1.2 9-5.5 9-11V6zm0 7.5L6.5 6.7 12 4l5.5 2.7z" fill="currentColor"/></svg>
                        </span>
                        <span>@entry.card.Subtitle</span>
                    </div>
                    <div class="spotlight-card__metric">
                        <span>Active</span>
                        <small>Manager</small>
                    </div>
                </div>
                <div class="spotlight-card__body">
                    <h3>@entry.card.Title</h3>
                    <p>@entry.card.Subtitle</p>
                    <p>@entry.card.Body</p>
                </div>
                <div class="people-card__role-band" aria-label="Role summary">
                    <span class="people-card__role-label">Role</span>
                    <strong>Team Captain - Manager</strong>
                </div>
            </article>
        }
    </div>
</section>

@section Scripts {
    <script src="~/js/ajax-search.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            initializeAjaxSearch({
                searchUrl: '@Url.Action("Search", "Managers")',
                resultGrid: document.getElementById('resultGrid'),
                searchInput: document.getElementById('searchInput'),
                searchBtn: document.getElementById('searchBtn'),
                clearBtn: document.getElementById('clearSearchBtn'),
                searchMessage: document.getElementById('searchMessage'),
                cardTemplate: (card, index) => {
                    const badgeVariant = index % 3 === 0 ? 'purple' : index % 3 === 1 ? 'green' : 'orange';
                    return `
                        <article class="spotlight-card people-card people-card--manager spotlight-card--${badgeVariant}">
                            <a class="people-card__hit-area" href="${card.linkUrl}" aria-label="Open ${card.title} details"></a>
                            <div class="spotlight-card__glow"></div>
                            <div class="spotlight-card__ribbon">Manager profile</div>
                            <div class="spotlight-card__header">
                                <div class="spotlight-card__badge spotlight-card__badge--${badgeVariant}">
                                    <span class="spotlight-card__badge-icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24"><path d="M12 2 3 6v5c0 5.5 3.8 9.8 9 11 5.2-1.2 9-5.5 9-11V6zm0 7.5L6.5 6.7 12 4l5.5 2.7z" fill="currentColor"/></svg>
                                    </span>
                                    <span>${card.subtitle}</span>
                                </div>
                                <div class="spotlight-card__metric">
                                    <span>Active</span>
                                    <small>Manager</small>
                                </div>
                            </div>
                            <div class="spotlight-card__body">
                                <h3>${card.title}</h3>
                                <p>${card.subtitle}</p>
                                <p>${card.body}</p>
                            </div>
                            <div class="people-card__role-band" aria-label="Role summary">
                                <span class="people-card__role-label">Role</span>
                                <strong>Team Captain - Manager</strong>
                            </div>
                        </article>
                    `;
                }
            });
        });
    </script>
}
