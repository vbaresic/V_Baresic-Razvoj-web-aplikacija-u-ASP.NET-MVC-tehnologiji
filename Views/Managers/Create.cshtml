@model Manager
@{
    ViewData["Title"] = "Create Manager";
}

<section class="form-page form-page--create">
    <div class="form-header">
        <h1>Create New Manager</h1>
        <p class="section-copy">Add a new team manager to the tournament system.</p>
    </div>

    <article class="content-card form-card">
        <form asp-action="Create" method="post" class="ajax-form" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="form-group">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control form-input" placeholder="Enter manager name" required />
                <span asp-validation-for="Name" class="form-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="HiredAt" class="form-label"></label>
                <input asp-for="HiredAt" type="datetime-local" class="form-control form-input date-time-input" required />
                <span asp-validation-for="HiredAt" class="form-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="YearsOfExperience" class="form-label"></label>
                <input asp-for="YearsOfExperience" type="number" class="form-control form-input" placeholder="Years of experience" min="0" required />
                <span asp-validation-for="YearsOfExperience" class="form-error"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Create Manager</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </article>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/form-validation.js"></script>
    <script src="~/js/date-time-picker.js"></script>
}
